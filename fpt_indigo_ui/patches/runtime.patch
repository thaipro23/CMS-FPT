
const getFptAsset = (name) => `${getConfig().LMS_BASE_URL}/static/indigo/images/fpt/${name}`;

const FptInlineLogo = ({ compact = false }) => (
  <img
    src={getFptAsset('fpt-polytechnic-logo.png')}
    alt="FPT Polytechnic"
    style={{
      display: 'block',
      width: compact ? 176 : 226,
      height: compact ? 46 : 62,
      objectFit: 'contain',
      objectPosition: 'left center',
    }}
  />
);

const FptHeaderLogo = () => {
  const baseUrl = getConfig().LMS_BASE_URL;
  return (
    <a href={`${baseUrl}/dashboard`} aria-label="FPT Polytechnic" className="logo fpt-ui-header-logo" style={{ textDecoration: 'none' }}>
      <FptInlineLogo compact />
    </a>
  );
};

