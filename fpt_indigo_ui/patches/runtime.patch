    src={getFptAsset(white ? 'fpt-polytechnic-logo-white.png' : 'fpt-polytechnic-logo.png')}
    alt="FPT Polytechnic"
    style={{
      display: 'block',
      width: compact ? 176 : 226,
      height: compact ? 46 : 62,
      objectFit: 'contain',
      objectPosition: 'left center',
    }}
  />
);

