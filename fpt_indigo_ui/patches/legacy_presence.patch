# Add the online-presence badge to the authenticated legacy LMS header.
# This uses the Indigo theme template override path instead of DOM replacement,
# keeping legacy LMS customization separate from MFE plugin slots.
RUN python - <<'PY'
from pathlib import Path

path = Path('/openedx/themes/indigo/lms/templates/header/navbar-authenticated.html')
if not path.exists():
    raise RuntimeError(f'Legacy LMS authenticated navbar template not found: {path}')

text = path.read_text(encoding='utf-8')
marker = '<!-- FPT_PRESENCE_LEGACY_HEADER_V1 -->'

if marker not in text:
    anchor = '<%include file="./theme-toggle-button.html" />'
    if anchor not in text:
        raise RuntimeError('Indigo authenticated navbar anchor not found for FPT presence badge')

    block = r'''
<!-- FPT_PRESENCE_LEGACY_HEADER_V1 -->
<span id="fpt-presence-legacy" class="fpt-presence-legacy" hidden aria-live="polite">
  <span class="fpt-presence-legacy__dot" aria-hidden="true"></span>
  <span id="fpt-presence-legacy-count"></span>
</span>
<style>
  .fpt-presence-legacy{display:inline-flex;align-items:center;gap:7px;margin:0 12px 0 6px;padding:5px 8px;color:#34495E;font-size:13px;font-weight:650;line-height:1;white-space:nowrap}
  .fpt-presence-legacy[hidden]{display:none!important}
  .fpt-presence-legacy__dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#22C55E;box-shadow:0 0 0 2px rgba(34,197,94,.12)}
  @media(max-width:767px){.fpt-presence-legacy{margin-right:6px;padding:5px 4px;font-size:12px}.fpt-presence-legacy__dot{width:7px;height:7px}}
</style>
<script>
(function(){
  var root = document.getElementById('fpt-presence-legacy');
  var countNode = document.getElementById('fpt-presence-legacy-count');
  if (!root || !countNode) return;

  var formatter;
  try { formatter = new Intl.NumberFormat('vi-VN'); } catch (e) { formatter = null; }

  function render(value) {
    if (!Number.isFinite(value) || value < 0) {
      root.hidden = true;
      return;
    }
    countNode.textContent = (formatter ? formatter.format(value) : String(value)) + ' online';
    root.hidden = false;
  }

  function refresh() {
    fetch('/api/fpt-presence/v1/count', {
      credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    })
      .then(function(response) {
        if (!response.ok) throw new Error('presence count HTTP ' + response.status);
        return response.json();
      })
      .then(function(payload) {
        render(Number(payload && payload.online));
      })
      .catch(function() {
        root.hidden = true;
      });
  }

  refresh();
  window.setInterval(refresh, 60000);
})();
</script>
'''
    text = text.replace(anchor, block + '\n' + anchor, 1)
    path.write_text(text, encoding='utf-8')
PY
