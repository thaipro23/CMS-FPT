# Reuse the exact final Discovery Hero from /courses on the LMS homepage (/).
RUN python - <<'PY5'
from pathlib import Path

courses = Path('/openedx/themes/indigo/lms/templates/courseware/courses.html')
home = Path('/openedx/themes/indigo/lms/templates/index.html')

start = '<!-- FPT_DISCOVERY_V8_START -->'
end = '<!-- FPT_DISCOVERY_V8_END -->'
home_anchor = '<section class="home style-logout">'
search_old = '<div class="course-search">'
search_new = '<div id="discovery-form" class="course-search">'

if not courses.exists():
    raise RuntimeError('Indigo courses.html missing before homepage slider patch')
if not home.exists():
    raise RuntimeError('Indigo index.html missing before homepage slider patch')

courses_text = courses.read_text(encoding='utf-8')
if start not in courses_text or end not in courses_text:
    raise RuntimeError('Final FPT Discovery Hero missing from courses.html')

# Extract the complete already-polished Hero, including the V9 balance/theme CSS.
hero = start + courses_text.split(start, 1)[1].split(end, 1)[0] + end
if 'FPT_DISCOVERY_V9_BALANCE' not in hero:
    raise RuntimeError('Homepage slider patch must run after V9 Discovery balance patch')

text = home.read_text(encoding='utf-8')

# Keep the Hero idempotent and always synchronize it from /courses.
if start in text and end in text:
    before = text.split(start, 1)[0]
    after = text.split(end, 1)[1]
    text = before + hero + after
elif home_anchor in text:
    text = text.replace(home_anchor, hero + '\n' + home_anchor, 1)
else:
    raise RuntimeError('Indigo homepage anchor not found for FPT Hero insertion')

# Hero CTAs use #discovery-form on both / and /courses. Give the homepage search
# area the same anchor without changing its existing discovery behavior.
if search_new not in text:
    if search_old not in text:
        raise RuntimeError('Indigo homepage course-search anchor not found')
    text = text.replace(search_old, search_new, 1)

if text.count('id="fpt-hero-slider"') != 1:
    raise RuntimeError('Homepage must contain exactly one FPT Hero slider')
if text.count('id="discovery-form"') != 1:
    raise RuntimeError('Homepage must contain exactly one discovery-form anchor')

home.write_text(text, encoding='utf-8')
PY5
