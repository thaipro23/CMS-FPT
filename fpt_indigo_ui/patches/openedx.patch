  <div class="fpt-hero__nav" role="tablist" aria-label="Chọn slide"><button class="fpt-dot is-active" type="button" aria-label="Slide 1"></button><button class="fpt-dot" type="button" aria-label="Slide 2"></button><button class="fpt-dot" type="button" aria-label="Slide 3"></button></div>
</div>
<script>
(function(){
  var root=document.getElementById('fpt-hero-slider');if(!root)return;
  var slides=root.querySelectorAll('.fpt-slide'),dots=root.querySelectorAll('.fpt-dot');
  var prev=root.querySelector('.fpt-hero__arrow--prev'),next=root.querySelector('.fpt-hero__arrow--next');
  var i=0,timer=null,reduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function show(n){i=(n+slides.length)%slides.length;for(var x=0;x<slides.length;x++){slides[x].classList.toggle('is-active',x===i);dots[x].classList.toggle('is-active',x===i);dots[x].setAttribute('aria-current',x===i?'true':'false')}}
  function stop(){if(timer){clearInterval(timer);timer=null}}
  function start(){stop();if(!reduced){timer=setInterval(function(){show(i+1)},7000)}}
  for(var d=0;d<dots.length;d++){(function(x){dots[x].addEventListener('click',function(){show(x);start()})})(d)}
  prev.addEventListener('click',function(){show(i-1);start()});next.addEventListener('click',function(){show(i+1);start()});
  root.addEventListener('mouseenter',stop);root.addEventListener('mouseleave',start);
  root.addEventListener('focusin',stop);root.addEventListener('focusout',start);
  root.addEventListener('keydown',function(e){if(e.key==='ArrowLeft'){show(i-1)}if(e.key==='ArrowRight'){show(i+1)}});
  show(0);start();
})();
</script>
</section>
<!-- FPT_DISCOVERY_V8_END -->
'''
    if start in text and end in text:
        before = text.split(start, 1)[0]
        after = text.split(end, 1)[1]
        text = before + hero + after
    elif anchor in text:
        text = text.replace(anchor, hero + '\n' + anchor, 1)
    courses.write_text(text, encoding='utf-8')

