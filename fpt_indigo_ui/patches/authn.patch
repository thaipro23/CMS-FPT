# Canonical FPT Polytechnic Authn customization for Open edX Ulmo.4.
#
# This is the single source of truth for Authn. Do not stack later Vxx patches
# on top of it. The login React tree is SSO-only by construction: username,
# password, forgot-password, and local submit controls are not rendered at all,
# including when FEID/Google authentication returns an error.
RUN node - <<'JS2'
const fs = require('fs');

const layoutRoot = '/openedx/app/src/base-container/components/default-layout';
const paths = {
  large: `${layoutRoot}/LargeLayout.jsx`,
  medium: `${layoutRoot}/MediumLayout.jsx`,
  small: `${layoutRoot}/SmallLayout.jsx`,
  logistration: '/openedx/app/src/logistration/Logistration.jsx',
  login: '/openedx/app/src/login/LoginPage.jsx',
  thirdPartyAuth: '/openedx/app/src/common-components/ThirdPartyAuth.jsx',
  socialAuthProviders: '/openedx/app/src/common-components/SocialAuthProviders.jsx',
  scss: '/openedx/app/src/index.scss',
};

for (const path of Object.values(paths)) {
  if (!fs.existsSync(path)) {
    throw new Error(`FPT Authn canonical source target not found: ${path}`);
  }
}

const write = (path, value) => fs.writeFileSync(path, value, 'utf8');

const layoutPreamble = String.raw`import React from 'react';

import { getConfig } from '@edx/frontend-platform';

const getFptBaseUrl = () => getConfig().LMS_BASE_URL || window.location.origin;
const getFptAsset = (name) => new URL('/static/indigo/images/fpt/' + name, getFptBaseUrl()).toString();
const getFptHome = () => getConfig().MARKETING_SITE_BASE_URL || getFptBaseUrl();
`;

