const verification = {
  [paths.large]: 'FPT_AUTHN_CANONICAL_LAYOUT_V1',
  [paths.medium]: 'FPT_AUTHN_CANONICAL_LAYOUT_V1',
  [paths.small]: 'FPT_AUTHN_CANONICAL_LAYOUT_V1',
  [paths.logistration]: 'FPT_SSO_ONLY_LOGISTRATION_V1',
  [paths.login]: 'FPT_SSO_ONLY_LOGIN_V3',
  [paths.thirdPartyAuth]: 'FPT_SSO_ONLY_TPA_V3',
  [paths.socialAuthProviders]: 'FPT_SSO_ONLY_PROVIDERS_V3',
  [paths.scss]: 'FPT_AUTHN_CANONICAL_V1',
};
for (const [path, marker] of Object.entries(verification)) {
  const rendered = fs.readFileSync(path, 'utf8');
  if (!rendered.includes(marker)) {
    throw new Error(`FPT Authn canonical verification failed: ${path}`);
  }
}

const loginSource = fs.readFileSync(paths.login, 'utf8');
for (const forbidden of ['sign-in-form', 'PasswordField', 'loginRequest', 'forgot-password']) {
  if (loginSource.includes(forbidden)) {
    throw new Error(`FPT Authn local-login control leaked into LoginPage: ${forbidden}`);
  }
}

const logistrationSource = fs.readFileSync(paths.logistration, 'utf8');
if (!logistrationSource.includes('!fptSsoOnlyAuth')) {
  throw new Error('FPT Authn outer Sign in heading is not controlled by source logic');
}
