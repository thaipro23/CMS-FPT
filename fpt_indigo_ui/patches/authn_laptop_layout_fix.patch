# Keep the SSO login composition two-column on laptop-sized CSS viewports.
# Windows display scaling and DevTools can place a desktop browser below the
# upstream xl breakpoint even when there is ample room for the desktop shell.
RUN node - <<'JS6'
const fs = require('fs');

const scssPath = '/openedx/app/src/index.scss';
if (!fs.existsSync(scssPath)) {
  throw new Error(`Authn stylesheet not found: ${scssPath}`);
}

let scss = fs.readFileSync(scssPath, 'utf8');
const marker = 'FPT Polytechnic V16 laptop two-column SSO shell';
if (!scss.includes(marker)) {
  scss += String.raw`

/* FPT Polytechnic V16 laptop two-column SSO shell */
@media (min-width:992px) and (max-width:1199.98px) {
  html,
  body,
  #root {
    height:100%!important;
    min-height:100vh!important;
    min-height:100dvh!important;
    overflow:hidden!important;
    background:#FFFFFF!important;
  }

  .layout {
    display:grid!important;
    grid-template-columns:minmax(0,52%) minmax(400px,48%)!important;
    grid-template-rows:minmax(0,1fr)!important;
    align-items:stretch!important;
    width:100%!important;
    height:100vh!important;
    height:100dvh!important;
    min-height:100vh!important;
    min-height:100dvh!important;
    max-height:100dvh!important;
    overflow:hidden!important;
    background:#FFFFFF!important;
  }

  .fpt-auth-visual--medium {
    display:block!important;
    grid-column:1!important;
    grid-row:1!important;
    width:100%!important;
    height:100%!important;
    min-height:100%!important;
    background:#071A33!important;
  }

  .fpt-auth-visual--medium .fpt-auth-panel {
    width:100%!important;
    height:100%!important;
    min-height:100%!important;
    background:#071A33!important;
  }

  .fpt-auth-visual--medium .fpt-auth-logo-link {
    top:36px!important;
    left:40px!important;
  }

  .fpt-auth-visual--medium .fpt-auth-logo {
    width:190px!important;
  }

  .fpt-auth-visual--medium .fpt-auth-copy {
    width:min(470px,82%)!important;
    margin:auto!important;
    padding-top:0!important;
    gap:24px!important;
  }

  .fpt-auth-visual--medium .fpt-auth-slash {
    height:132px!important;
    border-left-width:5px!important;
  }

  .fpt-auth-visual--medium .fpt-auth-copy h1 {
    font-size:clamp(38px,4.1vw,52px)!important;
    line-height:1!important;
  }

  .layout > .content {
    display:flex!important;
    grid-column:2!important;
    grid-row:1!important;
    align-items:center!important;
    justify-content:center!important;
    width:100%!important;
    height:100%!important;
    min-width:0!important;
    min-height:0!important;
    padding:44px clamp(34px,4vw,58px)!important;
    overflow:auto!important;
    background:#FFFFFF!important;
  }
}
`;
  fs.writeFileSync(scssPath, scss, 'utf8');
}

if (!fs.readFileSync(scssPath, 'utf8').includes(marker)) {
  throw new Error('FPT Authn V16 laptop layout verification failed');
}
JS6
