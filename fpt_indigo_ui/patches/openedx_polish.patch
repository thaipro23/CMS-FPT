
# Small post-patch refinements kept separate from the main legacy branding block.
# Fail closed if the expected FPT markup changes unexpectedly.
RUN python - <<'PY3'
from pathlib import Path


def replace_once(text: str, old: str, new: str, label: str) -> str:
    if new in text:
        return text
    if old not in text:
        raise RuntimeError(f"FPT UI polish target not found: {label}")
    return text.replace(old, new, 1)


courses = Path('/openedx/themes/indigo/lms/templates/courseware/courses.html')
if courses.exists():
    text = courses.read_text(encoding='utf-8')
    text = replace_once(
        text,
        'role="tablist" aria-label="Chọn slide"',
        'role="group" aria-label="Chọn slide"',
        'hero navigation semantics',
    )
    text = replace_once(
        text,
        "root.addEventListener('focusin',stop);root.addEventListener('focusout',start);",
        "root.addEventListener('focusin',stop);root.addEventListener('focusout',function(e){if(!root.contains(e.relatedTarget)){start()}});",
        'hero focus/autoplay behavior',
    )
    text = replace_once(
        text,
        '.fpt-kicker{display:inline-flex;align-items:center;gap:8px;margin-bottom:14px;color:#F36F21;font-size:11px;line-height:1.2;font-weight:850;letter-spacing:.13em}',
        '.fpt-kicker{display:inline-flex;align-items:center;gap:8px;margin-bottom:14px;color:#C94E08;font-size:11px;line-height:1.2;font-weight:850;letter-spacing:.13em}',
        'hero small-text contrast',
    )
    text = replace_once(
        text,
        '.fpt-slide__cta{display:inline-flex!important;align-items:center;gap:8px;background:#F36F21;color:#fff!important;padding:12px 19px;border-radius:9px;font-weight:800;text-decoration:none!important;box-shadow:0 9px 22px rgba(243,111,33,.22);transition:transform .18s ease,box-shadow .18s ease,background .18s ease}',
        '.fpt-slide__cta{display:inline-flex!important;align-items:center;gap:8px;background:#C65310;color:#fff!important;padding:12px 19px;border-radius:9px;font-weight:800;text-decoration:none!important;box-shadow:0 9px 22px rgba(198,83,16,.22);transition:transform .18s ease,box-shadow .18s ease,background .18s ease}',
        'hero CTA contrast',
    )
    text = replace_once(
        text,
        '.fpt-slide__cta:hover{background:#E86414;transform:translateY(-1px);box-shadow:0 12px 26px rgba(243,111,33,.28)}',
        '.fpt-slide__cta:hover{background:#B94700;transform:translateY(-1px);box-shadow:0 12px 26px rgba(185,71,0,.28)}',
        'hero CTA hover contrast',
    )
    courses.write_text(text, encoding='utf-8')

