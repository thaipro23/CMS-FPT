# FPT Polytechnic Authn SSO-only layer.
#
# Applied after authn.patch/authn_polish.patch to the Ulmo.4 Authn MFE source.
# Keep backend-provided provider URLs, but own the FEID/Google presentation and
# avoid APIs that do not exist in frontend-app-authn release/ulmo.4.
RUN node - <<'JS4'
const fs = require('fs');

const loginPagePath = '/openedx/app/src/login/LoginPage.jsx';
const thirdPartyAuthPath = '/openedx/app/src/common-components/ThirdPartyAuth.jsx';
const socialAuthProvidersPath = '/openedx/app/src/common-components/SocialAuthProviders.jsx';
const scssPath = '/openedx/app/src/index.scss';

for (const path of [loginPagePath, thirdPartyAuthPath, socialAuthProvidersPath, scssPath]) {
  if (!fs.existsSync(path)) {
    throw new Error(`FPT SSO patch target not found: ${path}`);
  }
}

const assertCompatible = (path, expected, marker) => {
  const source = fs.readFileSync(path, 'utf8');
  if (!source.includes(expected) && !source.includes(marker)) {
    throw new Error(`FPT SSO patch does not recognize upstream source: ${path}`);
  }
};

assertCompatible(loginPagePath, '<Form id="sign-in-form" name="sign-in-form">', 'FPT_SSO_ONLY_LOGIN_V2');
assertCompatible(thirdPartyAuthPath, 'const ThirdPartyAuth = (props) => {', 'FPT_SSO_ONLY_TPA_V2');
assertCompatible(socialAuthProvidersPath, 'const SocialAuthProviders = (props) => {', 'FPT_SSO_ONLY_PROVIDERS_V2');

fs.writeFileSync(loginPagePath, String.raw`// FPT_SSO_ONLY_LOGIN_V2
import {
  useCallback, useEffect, useMemo, useState,
} from 'react';
import { useDispatch, useSelector } from 'react-redux';

import { getConfig } from '@edx/frontend-platform';
import { sendPageEvent } from '@edx/frontend-platform/analytics';
import { useIntl } from '@edx/frontend-platform/i18n';
import PropTypes from 'prop-types';
import { Helmet } from 'react-helmet';
import Skeleton from 'react-loading-skeleton';

import {
  InstitutionLogistration,
  RedirectLogistration,
  ThirdPartyAuthAlert,
} from '../common-components';
import { getThirdPartyAuthContext } from '../common-components/data/actions';
import { thirdPartyAuthContextSelector } from '../common-components/data/selectors';
import EnterpriseSSO from '../common-components/EnterpriseSSO';
import ThirdPartyAuth from '../common-components/ThirdPartyAuth';
import { PENDING_STATE } from '../data/constants';
import {
  getAllPossibleQueryParams,
  getTpaHint,
  getTpaProvider,
} from '../data/utils';
import { TPA_AUTHENTICATION_FAILURE } from './data/constants';
import LoginFailureMessage from './LoginFailure';
import messages from './messages';

const LoginPage = ({
  institutionLogin,
  handleInstitutionLogin,
}) => {
  const dispatch = useDispatch();
  const getTPADataFromBackend = useCallback(
    (urlParams) => dispatch(getThirdPartyAuthContext(urlParams)),
    [dispatch],
  );
  const {
    loginResult,
    thirdPartyAuthContext,
    thirdPartyAuthApiStatus,
  } = useSelector((state) => ({
    loginResult: state.login.loginResult,
    thirdPartyAuthContext: thirdPartyAuthContextSelector(state),
    thirdPartyAuthApiStatus: state.commonComponents.thirdPartyAuthApiStatus,
  }));
  const {
    providers,
    currentProvider,
    secondaryProviders,
    finishAuthUrl,
    platformName,
    errorMessage: thirdPartyErrorMessage,
  } = thirdPartyAuthContext;
  const { formatMessage } = useIntl();
  const queryParams = useMemo(() => getAllPossibleQueryParams(), []);
  const tpaHint = getTpaHint();
  const [errorCode, setErrorCode] = useState({
    type: '',
    count: 0,
    context: {},
  });

  useEffect(() => {
    sendPageEvent('login_and_registration', 'login');
  }, []);

  useEffect(() => {
    const payload = { ...queryParams };
    if (tpaHint) {
      payload.tpa_hint = tpaHint;
    }
    getTPADataFromBackend(payload);
  }, [queryParams, tpaHint, getTPADataFromBackend]);

  useEffect(() => {
    if (thirdPartyErrorMessage) {
      setErrorCode((previous) => ({
        type: TPA_AUTHENTICATION_FAILURE,
        count: previous.count + 1,
        context: { errorMessage: thirdPartyErrorMessage },
      }));
    }
  }, [thirdPartyErrorMessage]);

  const {
    provider,
    skipHintedLogin,
  } = getTpaProvider(tpaHint, providers, secondaryProviders);

  if (tpaHint) {
    if (thirdPartyAuthApiStatus === PENDING_STATE) {
      return <Skeleton height={58} count={2} />;
    }

    if (skipHintedLogin) {
      window.location.href = getConfig().LMS_BASE_URL + provider.loginUrl;
      return null;
    }

    if (provider) {
      return <EnterpriseSSO provider={provider} />;
    }
  }

  if (institutionLogin) {
    return (
      <InstitutionLogistration
        secondaryProviders={secondaryProviders}
        headingTitle={formatMessage(messages['institution.login.page.title'])}
      />
    );
  }

  return (
    <>
      <Helmet>
        <title>{formatMessage(messages['login.page.title'], { siteName: getConfig().SITE_NAME })}</title>
      </Helmet>
      <RedirectLogistration
        success={loginResult.success}
        redirectUrl={loginResult.redirectUrl}
        finishAuthUrl={finishAuthUrl}
      />
      <section className="fpt-sso-login" aria-label="Sign in with FEID or Google">
        <LoginFailureMessage
          errorCode={errorCode.type}
          errorCount={errorCode.count}
          context={errorCode.context}
        />
        <ThirdPartyAuthAlert
          currentProvider={currentProvider}
          platformName={platformName}
        />
        <ThirdPartyAuth
          currentProvider={currentProvider}
          providers={providers}
          secondaryProviders={secondaryProviders}
          handleInstitutionLogin={handleInstitutionLogin}
          thirdPartyAuthApiStatus={thirdPartyAuthApiStatus}
          isLoginPage
        />
      </section>
    </>
  );
};

LoginPage.propTypes = {
  institutionLogin: PropTypes.bool.isRequired,
  handleInstitutionLogin: PropTypes.func.isRequired,
};

export default LoginPage;
`, 'utf8');

fs.writeFileSync(thirdPartyAuthPath, String.raw`// FPT_SSO_ONLY_TPA_V2
import React from 'react';

import PropTypes from 'prop-types';
import Skeleton from 'react-loading-skeleton';

import SocialAuthProviders from './SocialAuthProviders';
import { LOGIN_PAGE, PENDING_STATE, REGISTER_PAGE } from '../data/constants';

const providerKey = (provider) => [provider?.name || '', provider?.id || ''].join(' ').trim().toLowerCase();
const isAllowedProvider = (provider) => {
  const key = providerKey(provider);
  return key.includes('feid') || key.includes('google');
};
const providerRank = (provider) => (providerKey(provider).includes('feid') ? 0 : 1);

const ThirdPartyAuth = (props) => {
  const {
    providers,
    secondaryProviders,
    thirdPartyAuthApiStatus,
    isLoginPage,
  } = props;

  const uniqueProviders = [...providers, ...secondaryProviders]
    .filter(isAllowedProvider)
    .filter((provider, index, all) => (
      all.findIndex((candidate) => (
        (candidate.id && candidate.id === provider.id)
        || providerKey(candidate) === providerKey(provider)
      )) === index
    ))
    .sort((left, right) => providerRank(left) - providerRank(right));

  const isPending = thirdPartyAuthApiStatus === PENDING_STATE;

  return (
    <div className="fpt-sso-auth">
      <h1 className="fpt-sso-auth__title">
        {isLoginPage ? 'Sign in with:' : 'Create account with:'}
      </h1>

      {isPending ? (
        <div className="fpt-sso-auth__skeleton" aria-label="Loading sign in providers">
          <Skeleton height={60} count={2} />
        </div>
      ) : (
        <div className="fpt-sso-auth__providers">
          <SocialAuthProviders
            socialAuthProviders={uniqueProviders}
            referrer={isLoginPage ? LOGIN_PAGE : REGISTER_PAGE}
          />
          {uniqueProviders.length === 0 && (
            <div className="fpt-sso-auth__empty" role="alert">
              FEID and Google sign-in are temporarily unavailable.
            </div>
          )}
        </div>
      )}
    </div>
  );
};

ThirdPartyAuth.defaultProps = {
  currentProvider: null,
  providers: [],
  secondaryProviders: [],
  thirdPartyAuthApiStatus: PENDING_STATE,
  isLoginPage: false,
};

ThirdPartyAuth.propTypes = {
  currentProvider: PropTypes.string,
  handleInstitutionLogin: PropTypes.func.isRequired,
  providers: PropTypes.arrayOf(PropTypes.shape({
    id: PropTypes.string,
    name: PropTypes.string,
    iconClass: PropTypes.string,
    iconImage: PropTypes.string,
    loginUrl: PropTypes.string,
    registerUrl: PropTypes.string,
  })),
  secondaryProviders: PropTypes.arrayOf(PropTypes.shape({
    id: PropTypes.string,
    name: PropTypes.string,
    iconClass: PropTypes.string,
    iconImage: PropTypes.string,
    loginUrl: PropTypes.string,
    registerUrl: PropTypes.string,
  })),
  thirdPartyAuthApiStatus: PropTypes.string,
  isLoginPage: PropTypes.bool,
};

export default ThirdPartyAuth;
`, 'utf8');

fs.writeFileSync(socialAuthProvidersPath, String.raw`// FPT_SSO_ONLY_PROVIDERS_V2
import React from 'react';

import { getConfig } from '@edx/frontend-platform';
import PropTypes from 'prop-types';

import { LOGIN_PAGE } from '../data/constants';

const providerKey = (provider) => [provider?.name || '', provider?.id || ''].join(' ').trim().toLowerCase();
const providerType = (provider) => (providerKey(provider).includes('google') ? 'google' : 'feid');

const FeidIcon = () => (
  <svg viewBox="0 0 28 28" role="img" aria-label="FEID" focusable="false">
    <rect x="1" y="1" width="26" height="26" rx="8" fill="#FFFFFF" />
    <path d="M7.2 6.8h12.4v4H11.4v3.2h6.7v3.8h-6.7v4.9H7.2V6.8Z" fill="#0B3B82" />
    <path d="M20.6 6.8h2.2v15.9h-2.2V6.8Z" fill="#F36F21" />
  </svg>
);

const GoogleIcon = () => (
  <svg viewBox="0 0 24 24" role="img" aria-label="Google" focusable="false">
    <path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.06H12v3.9h5.39a4.61 4.61 0 0 1-2 3.02v2.53h3.24c1.89-1.74 2.97-4.3 2.97-7.39Z" />
    <path fill="#34A853" d="M12 22c2.7 0 4.96-.89 6.62-2.41l-3.24-2.53c-.9.6-2.05.96-3.38.96-2.6 0-4.8-1.76-5.59-4.13H3.07v2.6A10 10 0 0 0 12 22Z" />
    <path fill="#FBBC05" d="M6.41 13.89A6.02 6.02 0 0 1 6.1 12c0-.66.11-1.3.31-1.89v-2.6H3.07A10 10 0 0 0 2 12c0 1.61.38 3.14 1.07 4.49l3.34-2.6Z" />
    <path fill="#EA4335" d="M12 5.98c1.47 0 2.79.5 3.83 1.5l2.86-2.87A9.65 9.65 0 0 0 12 2a10 10 0 0 0-8.93 5.51l3.34 2.6C7.2 7.74 9.4 5.98 12 5.98Z" />
  </svg>
);

const ArrowIcon = () => (
  <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
    <path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" strokeWidth="1.8" strokeLinecap="round" strokeLinejoin="round" />
  </svg>
);

const SocialAuthProviders = (props) => {
  const { referrer, socialAuthProviders } = props;

  function handleSubmit(event, provider) {
    event.preventDefault();
    const providerUrl = referrer === LOGIN_PAGE ? provider.loginUrl : provider.registerUrl;
    if (providerUrl) {
      window.location.href = getConfig().LMS_BASE_URL + providerUrl;
    }
  }

  return socialAuthProviders.map((provider) => {
    const type = providerType(provider);
    const label = type === 'google' ? 'Sign in with Google' : 'Sign in with FEID';

    return (
      <button
        id={'fpt-sso-' + (provider.id || type)}
        key={provider.id || (type + '-' + provider.name)}
        type="button"
        className={'fpt-sso-provider fpt-sso-provider--' + type}
        onClick={(event) => handleSubmit(event, provider)}
        aria-label={label}
      >
        <span className="fpt-sso-provider__icon" aria-hidden="true">
          {type === 'google' ? <GoogleIcon /> : <FeidIcon />}
        </span>
        <span className="fpt-sso-provider__label">{label}</span>
        <span className="fpt-sso-provider__arrow" aria-hidden="true"><ArrowIcon /></span>
      </button>
    );
  });
};

SocialAuthProviders.defaultProps = {
  referrer: LOGIN_PAGE,
  socialAuthProviders: [],
};

SocialAuthProviders.propTypes = {
  referrer: PropTypes.string,
  socialAuthProviders: PropTypes.arrayOf(PropTypes.shape({
    id: PropTypes.string,
    name: PropTypes.string,
    iconClass: PropTypes.string,
    iconImage: PropTypes.string,
    loginUrl: PropTypes.string,
    registerUrl: PropTypes.string,
    skipRegistrationForm: PropTypes.bool,
  })),
};

export default SocialAuthProviders;
`, 'utf8');

