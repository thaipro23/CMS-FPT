
# Final Authn viewport polish: keep the reference edX composition edge-to-edge,
# light-only, solid navy on the left, and free of nested vertical scrolling.
RUN node - <<'JS3'
const fs = require('fs');

const layoutRoot = '/openedx/app/src/base-container/components/default-layout';
for (const name of ['LargeLayout.jsx', 'MediumLayout.jsx', 'SmallLayout.jsx']) {
  const path = `${layoutRoot}/${name}`;
  if (!fs.existsSync(path)) {
    continue;
  }
  let source = fs.readFileSync(path, 'utf8');
  source = source.replaceAll(
    "getFptAsset('fpt-polytechnic-logo.png')",
    "getFptAsset('fpt-polytechnic-logo-white.png')",
  );
  source = source.replace(/ style=\{\{ backgroundImage:[^>]+\}\}/g, '');
  fs.writeFileSync(path, source, 'utf8');
}

const scss = '/openedx/app/src/index.scss';
if (!fs.existsSync(scss)) {
  throw new Error(`Authn stylesheet not found: ${scss}`);
}

const marker = 'FPT Polytechnic V11 authn edge-to-edge lock';
let current = fs.readFileSync(scss, 'utf8');
if (!current.includes(marker)) {
  current += String.raw`

/* FPT Polytechnic V11 authn edge-to-edge lock */
html,body,#root{width:100%!important;margin:0!important;padding:0!important;background:#fff!important;color-scheme:light!important}
body{background-image:none!important}
.layout{width:100vw!important;max-width:none!important;margin:0!important;padding:0!important;border:0!important;border-radius:0!important;box-shadow:none!important;background:#fff!important}
.fpt-auth-visual,.fpt-auth-panel,.fpt-auth-wedge,.layout>.content{margin:0!important;border:0!important;border-radius:0!important;box-shadow:none!important}
.fpt-auth-panel{background:#0B3B82!important;background-image:none!important}
.fpt-auth-logo--white{filter:none!important}
.layout>.content{background:#fff!important}
#main-content{background:transparent!important;border:0!important;border-radius:0!important;box-shadow:none!important}

@media (min-width:1200px){
  html,body,#root{height:100%!important;min-height:0!important;overflow:hidden!important}
  .layout{height:100vh!important;height:100dvh!important;min-height:100vh!important;min-height:100dvh!important;max-height:100dvh!important;overflow:hidden!important}
  .fpt-auth-visual--large,.fpt-auth-visual--large .fpt-auth-panel,.fpt-auth-visual--large .fpt-auth-wedge,.layout>.content{height:100%!important;min-height:0!important}
  .layout>.content{overflow:hidden!important}
  #main-content{max-height:calc(100dvh - 72px);overflow:visible}
}

@media (max-width:1199.98px){body{overflow:auto!important}}

html[data-paragon-theme-variant="dark"],
html[data-paragon-theme-variant="dark"] body,
html[data-paragon-theme-variant="dark"] #root,
html[data-paragon-theme-variant="dark"] .layout,
html[data-paragon-theme-variant="dark"] .layout>.content,
html[data-paragon-theme-variant="dark"] #main-content,
html[data-paragon-theme-variant="dark"] #main-content .form-control{background:#fff!important;color:#172B45!important}
`;
  fs.writeFileSync(scss, current, 'utf8');
}
JS3
