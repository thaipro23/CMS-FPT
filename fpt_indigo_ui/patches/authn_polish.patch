
# Final Authn viewport polish: keep the native edX-style FPT composition
# light-only, full-height on desktop, and free of nested vertical scrolling.
RUN node - <<'JS3'
const fs = require('fs');

const scss = '/openedx/app/src/index.scss';
if (!fs.existsSync(scss)) {
  throw new Error(`Authn stylesheet not found: ${scss}`);
}

const marker = 'FPT Polytechnic V9 authn viewport/theme polish';
let current = fs.readFileSync(scss, 'utf8');
if (!current.includes(marker)) {
  current += String.raw`

/* FPT Polytechnic V9 authn viewport/theme polish */
html { color-scheme:light; background:#fff; }
body { background:#fff; }

@media (min-width:1200px) {
  html,body,#root { height:100%; min-height:0; overflow:hidden; }
  .layout { height:100vh; height:100dvh; min-height:0!important; max-height:100dvh; overflow:hidden; }
  .fpt-auth-visual--large,.fpt-auth-visual--large .fpt-auth-panel,.fpt-auth-visual--large .fpt-auth-wedge { height:100%; min-height:0; }
  .layout > .content { height:100%; min-height:0; overflow:hidden; }
  #main-content { max-height:calc(100dvh - 64px); overflow:visible; }
}

@media (min-width:768px) and (max-width:1199.98px) {
  body { overflow:auto; }
}

@media (max-width:767.98px) {
  body { overflow:auto; }
}

/* Dark mode is intentionally disabled for the FPT deployment. These guards
   prevent a stale persisted variant from painting the custom Authn shell dark
   before runtime configuration normalizes the document back to light. */
html[data-paragon-theme-variant="dark"],
html[data-paragon-theme-variant="dark"] body,
html[data-paragon-theme-variant="dark"] #root,
html[data-paragon-theme-variant="dark"] .layout,
html[data-paragon-theme-variant="dark"] .layout > .content { background:#fff!important; color:#172B45!important; }
html[data-paragon-theme-variant="dark"] #main-content,
html[data-paragon-theme-variant="dark"] #main-content .form-control { background:#fff!important; color:#172B45!important; border-color:#C7D3E0!important; }
`;
  fs.writeFileSync(scss, current, 'utf8');
}
JS3
